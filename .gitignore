# Swift Package Manager
/.build
/Packages
.swiftpm/configuration/registries.json
.swiftpm/xcode/package.xcworkspace/contents.xcworkspacedata

# Xcode, per developer. Shared schemes under xcshareddata/ stay tracked so the
# demo app builds the same way for everyone.
xcuserdata/
DerivedData/
*.xcuserstate
*.moved-aside

# Signing. Set DEVELOPMENT_TEAM here rather than in project.pbxproj, so no
# contributor has to undo somebody else's team to build the demo.
Local.xcconfig

# Working notes. Where the material could go next, and what is deliberately not
# in the public package.
NOTES.md

.netrc
